# Copy to server/.env (NEVER commit real values). Placeholders only.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (exact match)
CLIENT_ORIGINS=http://localhost:5173
# Client build setting: set to the canonical public origin before `npm run build`.
# Used for canonical links. Update client/public/robots.txt and sitemap.xml with the same domain.
# VITE_SITE_URL=https://your-campuspages-domain.example
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuspages?retryWrites=true&w=majority
# Serve the built frontend from this same server (recommended: one origin, first-party cookies, no CORS). Run `npm run build` first.
# SERVE_CLIENT=true
# CLIENT_ORIGINS must then be your public https URL, e.g. https://campuspages.onrender.com
# Behind a reverse proxy/host that sets X-Forwarded-For (needed for correct rate limiting in prod):
# TRUST_PROXY=true
# Optional session/rate-limit tuning (defaults shown):
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_MAX_PER_15MIN=30           # FAILED logins per IP per 15 min (successful logins are not counted)
# Used only by the create-user CLI (prefer the hidden prompt; never commit a real value):
# CAMPUSPAGES_NEW_PASSWORD=
# Storage (Phase 3). Cloudinary is the storage provider (replaces R2). Values come from the Cloudinary console.
# Server-side only; never put these in client code or commit them.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# STORAGE_DRIVER=cloudinary        # 'memory' (dev/test only, data lost on restart) is used automatically if credentials are absent; refused in production
# MAX_UPLOAD_MB=10                 # Keep at or below your storage provider's per-file limit
# MAX_PDF_PAGES=500
# MAX_IMAGE_MEGAPIXELS=25
# MAX_CONCURRENT_UPLOADS=3
# Request/processing limits (per API process; defaults shown):
# API_MAX_PER_MIN=3000             # per IP. Campus networks share one public IP: raise this if you see 429s for whole classes
# LOGIN_MAX_PER_ACCOUNT_15MIN=20
# MAX_SESSIONS_PER_USER=5
# REQUEST_TIMEOUT_MS=30000
# PDF_PARSE_TIMEOUT_MS=10000
# LOG_REQUESTS=true                # one safe log line per request (default: on, except in tests)
# Content streaming limits (per API process):
# MAX_STREAMS_PER_USER=12
# MAX_STREAMS_GLOBAL=200
# CONTENT_MAX_PER_MIN=300
# STREAM_TIMEOUT_SECONDS=120
# UPSTREAM_TIMEOUT_MS=15000
# CLEANUP_AFTER_MINUTES=30
